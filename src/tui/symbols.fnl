(local line {:horizontal "─"
             :join-cross "┼"
             :join-down "┬"
             :join-up "┴"
             :vertical "│"
             :separator "│"
             :corner-top-left "┌"
             :corner-top-right "┐"
             :corner-bottom-left "└"
             :corner-bottom-right "┘"
             :tee-left "├"
             :tee-right "┤"
             :scroll-thumb "█"
             :horizontal-scroll-thumb "▀"
             :wrap-arrow "↪"})

{: line}
