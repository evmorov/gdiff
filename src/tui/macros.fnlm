(fn field-pairs [fields]
  (if (= :table (type (. fields 1)))
      fields
      (do
        (assert (= 0 (% (length fields) 2)) "expected field key/value pairs")
        (let [pairs []]
          (for [i 1 (length fields) 2]
            (table.insert pairs [(. fields i) (. fields (+ i 1))]))
          pairs))))

(fn defnode [name args node-type & fields]
  (assert name "expected node constructor name")
  (assert args "expected node constructor arguments")
  (assert node-type "expected node type")
  (let [node (gensym "node")
        setters []
        fields (field-pairs fields)]
    (each [_ field (ipairs fields)]
      (assert (= 2 (length field)) "expected [field value]")
      (table.insert setters `(tset ,node ,(. field 1) ,(. field 2))))
    `(fn ,name
       ,args
       (let [,node {:type ,node-type}]
         (do
           ,(unpack setters))
         ,node))))

(fn defrenderer [node-type component]
  `(renderer.register ,node-type ,component))

{: defnode : defrenderer}
